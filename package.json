{
  "name": "audio-analyzer-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:full": "concurrently -n vite,api,helper -c cyan,yellow,magenta \"vite --port 5173\" \"node scripts/dev-api.mjs\" \"node helper/remix-helper.mjs\"",
    "helper": "node helper/remix-helper.mjs",
    "helper:install": "bash helper/install-launchagent.sh",
    "menubar": "python3 -c \"import rumps\" 2>/dev/null && python3 helper/menubar/remix_menubar.py || echo \"rumps not installed - run npm run menubar:install (installs it in a venv) or pip install rumps\"",
    "menubar:install": "bash helper/menubar/install.sh"
  },
  "dependencies": {
    "@sentry/react": "^10.38.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/blob": "^2.0.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.16.0",
    "motion": "^12.36.0",
    "posthog-js": "^1.345.2",
    "posthog-node": "^5.34.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
